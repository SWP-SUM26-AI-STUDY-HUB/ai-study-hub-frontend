#      cp .env.example .env
#  (file .env đã được gitignore — KHÔNG commit lên repo, mỗi máy tự giữ 1 bản)
# =====================================================================

# URL của backend mà frontend sẽ gọi tới khi code local (trỏ thẳng vào backend).
#   - Backend trên VPS:      http://14.225.254.145:8080
#   - Backend chạy máy bạn:  http://localhost:8080
VITE_API_BASE_URL=http://14.225.254.145:8080

# ---------------------------------------------------------------------
#  Lưu ý khi DEPLOY lên VPS: KHÔNG cần tạo file .env.
#  Lúc build production, VITE_API_BASE_URL tự là rỗng và nginx đứng giữa
#  forward /api sang backend → frontend vẫn chạy bình thường.
